# Copy to .env and change the password. .env is ignored by git.
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supplychain

# Host ports (all bound to 127.0.0.1)
DB_PORT=5442
API_PORT=8100
WEB_PORT=8095

# Keycloak: existing `citizen` instance reached with
#   kubectl -n citizen port-forward svc/keycloak 8180:8080
# Containers reach the forwarded port through host.docker.internal.
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8180
KEYCLOAK_REALM=supplychain
KEYCLOAK_ISSUER=http://localhost:8180/realms/supplychain

# Sign-in. "dev" uses the identity switch in the top bar and header identities (local development only).
# "keycloak" requires a real access token on every request.
AUTH_MODE=dev

# Optional Keycloak container (docker compose --profile keycloak up -d keycloak, then keycloak/setup.py).
# With it, point the API at the container inside the Docker network:
#   KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
