# Copy to .env and change the password. .env is ignored by git.
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supplychain

# Host ports (all bound to 127.0.0.1)
DB_PORT=5442
API_PORT=8100
WEB_PORT=8095

# Sign-in uses the Keycloak container in this stack. The API reaches it inside the Docker network;
# browsers use KEYCLOAK_ISSUER (the address Keycloak publishes on this machine).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=supplychain
KEYCLOAK_ISSUER=http://localhost:8180/realms/supplychain

# "keycloak" (default): every request needs a real access token. "dev": the identity switch in the top bar and
# header identities; local development only, never on a network. Switch with: AUTH_MODE=dev docker compose up -d api
AUTH_MODE=keycloak

# Keycloak administrator, and the password the seed users get the first time (change it in Keycloak afterwards).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me-too
